# development | production
# In production, FRONTEND_ORIGIN and DATABASE_URL must be set explicitly
# (no localhost/./data defaults are applied).
APP_ENV=development

OPENAI_API_KEY=your_api_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Defaults to http://localhost:5173 when APP_ENV=development.
FRONTEND_ORIGIN=http://localhost:5173

# SQLite path, used only when APP_ENV=development.
# Defaults to ./data/mindk.db when unset.
DATABASE_PATH=./data/mindk.db

# PostgreSQL connection string, required when APP_ENV=production.
# Not used in development. Do not commit a real value here.
# DATABASE_URL=postgres://user:password@host:5432/mindk
