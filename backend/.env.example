# development | production
# In production, FRONTEND_ORIGIN and DATABASE_PATH must be set explicitly
# (no localhost/./data defaults are applied).
APP_ENV=development

OPENAI_API_KEY=your_api_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Defaults to http://localhost:5173 when APP_ENV=development.
FRONTEND_ORIGIN=http://localhost:5173

# Defaults to ./data/mindk.db when APP_ENV=development.
DATABASE_PATH=./data/mindk.db
