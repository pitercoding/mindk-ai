{
    "swagger": "2.0",
    "info": {
        "description": "MindK AI API: notes, documents with semantic search (RAG), and AI chat over that content.\nAll endpoints require authentication except /health.",
        "title": "MindK AI API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/chat": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Sends a message to the assistant. If session_id is omitted or 0, a new session is created automatically and mode (\"knowledge\" or \"note\") is then required; note-mode sessions also require note_id. In \"knowledge\" mode the answer is grounded in the user's notes and, when relevant, a semantic search over their documents (returned as sources). In \"note\" mode the answer is grounded in a single note. This endpoint has a stricter rate limit than the rest of the API (10 requests/minute per user) because it drives LLM calls.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "chat"
                ],
                "summary": "Ask the assistant",
                "parameters": [
                    {
                        "description": "Chat message",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.ChatRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.ChatResponse"
                        }
                    },
                    "400": {
                        "description": "message is required/too long, or mode is missing/invalid for a new session",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "session not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "413": {
                        "description": "request body too large",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "429": {
                        "description": "rate limit exceeded (see Retry-After header)",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "failed to process chat request",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/chat/messages/": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Saves a message (role \"user\" or \"assistant\") on an existing chat session owned by the authenticated user. The session is identified by session_id in the body, not in the URL.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "chat-messages"
                ],
                "summary": "Save chat message",
                "parameters": [
                    {
                        "description": "Message to save (session_id, role and content are required)",
                        "name": "message",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.ChatMessage"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/models.ChatMessage"
                        }
                    },
                    "400": {
                        "description": "content is required/too long, or role is invalid",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "session not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "413": {
                        "description": "request body too large",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "failed to save message",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/chat/messages/{sessionId}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Returns every message on the given chat session, if it exists and is owned by the authenticated user. The session is identified by its ID in the URL.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "chat-messages"
                ],
                "summary": "List messages in a chat session",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Chat session ID",
                        "name": "sessionId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.ChatMessage"
                            }
                        }
                    },
                    "400": {
                        "description": "invalid session id",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "session not found",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "failed to fetch chat messages",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
