            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Replaces title, mode and note_id of an existing chat session owned by the authenticated user.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "chat-sessions"
                ],
                "summary": "Update chat session",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Chat session ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Updated title and mode",
                        "name": "session",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.ChatSession"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
