            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Creates a chat session. mode must be \"knowledge\" or \"note\"; note_id is meaningful only for \"note\" mode. user_id is taken from the token, not the body.",
