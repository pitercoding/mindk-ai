                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "chat-sessions"
                ],
                "summary": "Create chat session",
                "parameters": [
                    {
                        "description": "Session to create (title and mode are required)",
                        "name": "session",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.ChatSession"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/models.ChatSession"
                        }
                    },
                    "400": {
                        "description": "title and mode are required, title too long, or mode is invalid",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "413": {
                        "description": "request body too large",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "failed to create session",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/chat/sessions/{id}": {
            "get": {
                "security": [
                    {
