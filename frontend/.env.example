# Clerk publishable key. Safe to expose to the browser (it is not a secret).
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_public_key_here

# Base URL of the backend API. Defaults to http://localhost:8080 when unset.
# Only public values belong in VITE_* variables - never put API keys,
# database credentials, or other secrets here; anything prefixed VITE_ is
# bundled into the client build and visible to anyone using the app.
VITE_API_URL=http://localhost:8080